:root {
  --primary-color: #646cff;
  --primary-hover: #535bf2;
  --bg-color: #242424;
  --text-color: rgba(255, 255, 255, 0.87);
  --border-color: rgba(255, 255, 255, 0.1);
  --card-bg: #1a1a1a;
  --tag-bg: rgba(100, 108, 255, 0.1);
  --tag-color: #646cff;
  --shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: var(--text-color);
  background-color: var(--bg-color);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Header */
.app-header {
  text-align: center;
  padding: 2rem 1rem;
  border-bottom: 1px solid var(--border-color);
}

.app-title {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  background: linear-gradient(135deg, #646cff 0%, #747bff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.app-subtitle {
  font-size: 1.1rem;
  color: rgba(255, 255, 255, 0.6);
}

/* Search */
.search-container {
  max-width: 600px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.search-input {
  width: 100%;
  padding: 1rem 1.5rem;
  font-size: 1rem;
  border: 2px solid var(--border-color);
  border-radius: 12px;
  background-color: var(--card-bg);
  color: var(--text-color);
  transition: border-color 0.3s, box-shadow 0.3s;
}

.search-input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(100, 108, 255, 0.1);
}

.search-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

/* Gallery */
.gif-gallery {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 1rem;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 2rem;
}

/* GIF Card */
.gif-card {
  background-color: var(--card-bg);
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
  border: 1px solid var(--border-color);
}

.gif-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.gif-image-container {
  width: 100%;
  height: 250px;
  overflow: hidden;
  background-color: rgba(0, 0, 0, 0.3);
}

.gif-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.gif-info {
  padding: 1.5rem;
}

.gif-title {
  font-size: 1.3rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--text-color);
}

.gif-author,
.gif-rating {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 0.5rem;
}

.gif-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 1rem 0;
}

.tag {
  background-color: var(--tag-bg);
  color: var(--tag-color);
  padding: 0.3rem 0.8rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 500;
}

.gif-description {
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  font-style: italic;
}

/* No Results */
.no-results {
  text-align: center;
  padding: 4rem 1rem;
  grid-column: 1 / -1;
}

.no-results p:first-child {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}

.no-results-hint {
  color: rgba(255, 255, 255, 0.5);
  font-size: 1rem;
}

/* Responsive */
@media (max-width: 768px) {
  .app-title {
    font-size: 2rem;
  }

  .gif-gallery {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 1.5rem 1rem;
  }

  .gif-image-container {
    height: 200px;
  }
}

@media (max-width: 480px) {
  .app-title {
    font-size: 1.8rem;
  }

  .app-subtitle {
    font-size: 1rem;
  }

  .search-container {
    margin: 1.5rem auto;
  }

  .search-input {
    padding: 0.875rem 1.25rem;
  }
}
